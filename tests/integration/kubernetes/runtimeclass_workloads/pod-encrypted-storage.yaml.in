apiVersion: v1
kind: Pod
metadata:
  name: storage-encrypted
  labels:
    app: storage-encrypted
spec:
  runtimeClassName: kata
  shareProcessNamespace: true
  restartPolicy: Never
  initContainers:
  - name: format-disk
    image: OSC_STORAGE_HELPER_IMAGE
    command: ["/usr/local/bin/luks-helper", "format-disk"]
    securityContext:
      privileged: true
    restartPolicy: Always
    env:
    - name: PASS
      valueFrom:
        secretKeyRef:
          name: sealed-secrets
          key: secret
    volumeMounts:
    - name: storage-ipc
      mountPath: /dev/shm
    volumeDevices:
    - name: luks-block
      devicePath: /dev/block-device
  - name: check-ready
    image: OSC_STORAGE_HELPER_IMAGE
    command: ["/usr/local/bin/luks-helper", "wait-ready"]
    securityContext:
      privileged: true
    volumeMounts:
    - name: storage-ipc
      mountPath: /dev/shm
  containers:
  - name: hello-openshift
    image: registry.access.redhat.com/ubi9/ubi@sha256:48393e4261b2544f652c915b3e052256ddf66ee95cd04dc0362191f302c4e94a
    command: ["sleep", "infinity"]
    ports:
    - containerPort: 8888
    env:
    - name: DATA_DIR
      value: /data
    lifecycle:
      postStart:
        exec:
          command:
          - /bin/sh
          - -c
          - |
            PID=$(cat /dev/shm/luks-helper.pid)
            chmod ug+w "$(dirname "$DATA_DIR")"
            ln -sfn "/proc/$PID/root/mnt/storage" "$DATA_DIR"
    securityContext:
      privileged: true
    volumeMounts:
    - name: storage-ipc
      mountPath: /dev/shm
  volumes:
  - name: luks-block
    persistentVolumeClaim:
      claimName: storage-encrypted
  - name: storage-ipc
    emptyDir:
      medium: Memory
