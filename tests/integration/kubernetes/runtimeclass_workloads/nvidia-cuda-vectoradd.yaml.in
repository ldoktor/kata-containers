apiVersion: v1
kind: Pod
metadata:
  name: ${POD_NAME_CUDA}
  labels:
    app: ${POD_NAME_CUDA}
  annotations:
    io.katacontainers.config.hypervisor.default_memory: "${CUDA_VM_MEMORY}"
spec:
  runtimeClassName: kata
  restartPolicy: Never
  containers:
  - name: cuda-vectoradd
    image: "${CUDA_VECTORADD_IMAGE}"
    imagePullPolicy: IfNotPresent
    resources:
      limits:
        nvidia.com/pgpu: "1"
